{
  "name": "@mmg/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "sharp": "^0.35.3",
    "zod": "4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/deploy.ts --bundle --platform=node --format=esm --target=node22 --outfile=lib/index.js --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:sharp",
    "test": "vitest run src",
    "test:emulator": "vitest run src --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

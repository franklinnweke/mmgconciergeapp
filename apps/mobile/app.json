{
  "expo": {
    "name": "MMG Concierge",
    "slug": "mmg-concierge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mmgconcierge",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.mmgconcierge.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "MMG Concierge uses the camera to photograph your government ID for owner verification. The image stays private.",
        "NSPhotoLibraryUsageDescription": "MMG Concierge accesses your photo library so you can upload your government ID for owner verification. The image stays private."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.mmgconcierge.app",
      "adaptiveIcon": {
        "backgroundColor": "#040404",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/app-check",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040404",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7eb4c74d-8609-4bba-a6d1-18b4bee94834"
      }
    },
    "owner": "mmg-concierge"
  }
}

{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "MMG_FIREBASE_ENV": "development",
        "MMG_APNS_ENV": "production"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "MMG_FIREBASE_ENV": "development",
        "MMG_APNS_ENV": "production"
      }
    },
    "testflight-development": {
      "extends": "production",
      "env": {
        "MMG_FIREBASE_ENV": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "MMG_FIREBASE_ENV": "production",
        "MMG_APNS_ENV": "production"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    }
  },
  "submit": {
    "testflight-development": {
      "ios": {
        "ascAppId": "6801330614"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6801330614"
      }
    }
  }
}

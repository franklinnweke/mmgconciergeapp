rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function pathUidIsAuth(ownerId) {
      return isAuth() && request.auth.uid == ownerId;
    }

    function registeredAccount() {
      let account = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      return account != null
        && account.data != null
        && account.data.uid == request.auth.uid
        && account.data.accountType in ['owner', 'renter'];
    }

    // Server-owned capability, never the registration-path compatibility label.
    function ownerCapability(allowedStates) {
      let profile = firestore.get(/databases/(default)/documents/ownerProfiles/$(request.auth.uid));
      return request.auth.token.email_verified == true
        && profile != null && profile.data != null
        && profile.data.ownerId == request.auth.uid
        && profile.data.version is int && profile.data.version > 0
        && profile.data.verificationStatus in allowedStates;
    }

    function editableVehicleOwnedByAuth(vehicleId) {
      let vehicle = firestore.get(/databases/(default)/documents/vehicles/$(vehicleId));
      return vehicle != null
        && vehicle.data != null
        && vehicle.data.ownerId == request.auth.uid
        && vehicle.data.visibility != 'deleted'
        && vehicle.data.moderationStatus in ['draft', 'rejected'];
    }

    function allowedIdImage() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'application/pdf'
      ] && request.resource.size <= 10 * 1024 * 1024
        && request.resource.name.matches('private/owner-verification/[^/]+/[^/]+')
        && request.resource.metadata.purpose == 'government_id'
        && request.resource.metadata.ownerId == request.auth.uid;
    }

    function allowedProfilePhoto(renterId) {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif'
      ] && request.resource.size <= 5 * 1024 * 1024
        && request.resource.metadata.purpose == 'profile_photo'
        && request.resource.metadata.renterId == renterId;
    }

    match /private/owner-verification/{ownerId}/{uploadId} {
      allow read: if false;
      allow create: if pathUidIsAuth(ownerId)
        && registeredAccount()
        && ownerCapability(['draft', 'rejected'])
        && ownerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && uploadId.matches('^[A-Za-z0-9_-]{8,128}$')
        && allowedIdImage();
      allow update, delete: if false;
    }

    // Renter profile photos are self-owned profile enrichment, not identity documents.
    match /private/renter-profile/{renterId}/avatar {
      allow read: if pathUidIsAuth(renterId) && registeredAccount();
      allow create, update: if pathUidIsAuth(renterId)
        && registeredAccount()
        && renterId.matches('^[A-Za-z0-9_-]{1,128}$')
        && allowedProfilePhoto(renterId);
      allow delete: if pathUidIsAuth(renterId) && registeredAccount();
    }

    // ── Vehicle image paths ──

    match /public/vehicles/{vehicleId}/approved/{imageId}/{variant} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /private/vehicle-uploads/{ownerId}/{vehicleId}/{uploadId} {
      allow read: if false;
      allow create: if pathUidIsAuth(ownerId)
        && ownerCapability(['approved'])
        && editableVehicleOwnedByAuth(vehicleId)
        && ownerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && vehicleId.matches('^[A-Za-z0-9_-]{1,128}$')
        && uploadId.matches('^[A-Za-z0-9_-]{8,128}$')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.purpose == 'vehicle_image'
        && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /private/vehicle-documents/{ownerId}/{vehicleId}/{uploadId} {
      allow read: if false;
      allow create: if pathUidIsAuth(ownerId)
        && ownerCapability(['approved'])
        && editableVehicleOwnedByAuth(vehicleId)
        && ownerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && vehicleId.matches('^[A-Za-z0-9_-]{1,128}$')
        && uploadId.matches('^[A-Za-z0-9_-]{8,128}$')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.purpose == 'vehicle_document'
        && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

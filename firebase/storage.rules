rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function pathUidIsAuth(ownerId) {
      return isAuth() && request.auth.uid == ownerId;
    }

    function ownerAccount() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accountType == 'owner';
    }

    function vehicleOwnedByAuth(vehicleId) {
      return firestore.get(/databases/(default)/documents/vehicles/$(vehicleId)).data.ownerId == request.auth.uid;
    }

    function allowedIdImage() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'application/pdf'
      ] && request.resource.size <= 10 * 1024 * 1024
        && request.resource.name.matches('private/owner-verification/[^/]+/[^/]+')
        && request.resource.metadata.purpose == 'government_id'
        && request.resource.metadata.ownerId == request.auth.uid;
    }

    match /private/owner-verification/{ownerId}/{uploadId} {
      allow read: if false;
      allow create: if pathUidIsAuth(ownerId)
        && ownerAccount()
        && ownerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && uploadId.matches('^[A-Za-z0-9_-]{8,128}$')
        && allowedIdImage();
      allow update, delete: if false;
    }

    // ── Vehicle image paths ──

    match /public/vehicles/{vehicleId}/approved/{imageId}/{variant} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /private/vehicle-uploads/{ownerId}/{vehicleId}/{uploadId} {
      allow read: if false;
      allow create: if pathUidIsAuth(ownerId)
        && ownerAccount()
        && vehicleOwnedByAuth(vehicleId)
        && ownerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && vehicleId.matches('^[A-Za-z0-9_-]{1,128}$')
        && uploadId.matches('^[A-Za-z0-9_-]{8,128}$')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.purpose == 'vehicle_image'
        && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /private/vehicle-documents/{ownerId}/{vehicleId}/{uploadId} {
      allow read: if false;
      allow create: if pathUidIsAuth(ownerId)
        && ownerAccount()
        && vehicleOwnedByAuth(vehicleId)
        && ownerId.matches('^[A-Za-z0-9_-]{1,128}$')
        && vehicleId.matches('^[A-Za-z0-9_-]{1,128}$')
        && uploadId.matches('^[A-Za-z0-9_-]{8,128}$')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.purpose == 'vehicle_document'
        && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "MMG_FIREBASE_ENV": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "MMG_FIREBASE_ENV": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "MMG_FIREBASE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
